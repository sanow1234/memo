{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.python-practice/problem.schema.json",
  "title": "Python practice problem collection",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "difficulty",
      "concepts",
      "description",
      "inputDescription",
      "outputDescription",
      "examples",
      "starterCode",
      "timeLimitMs",
      "testCases"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9]{3,}$" },
      "title": { "type": "string", "minLength": 1 },
      "difficulty": { "enum": ["easy", "medium", "hard"] },
      "concepts": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "variables-types",
            "input-output",
            "arithmetic",
            "comparison-logic",
            "conditionals",
            "loops",
            "nested-loops",
            "strings",
            "lists",
            "tuples",
            "dictionaries",
            "functions"
          ]
        }
      },
      "description": { "type": "string", "minLength": 1 },
      "inputDescription": { "type": "string", "minLength": 1 },
      "outputDescription": { "type": "string", "minLength": 1 },
      "examples": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/example" }
      },
      "starterCode": { "type": "string" },
      "timeLimitMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 10000
      },
      "testCases": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/testCase" }
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "expectedOutput"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "expectedOutput": { "type": "string" }
      }
    }
  }
}
